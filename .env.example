# ──────────────────────────────────────────────
# DocuMind AI — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in any keys you want to use.
# All cloud providers are optional — the app works fully offline
# with Ollama or the extractive fallback.

# ── Cloud LLM Providers (optional) ───────────
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
TOGETHER_API_KEY=

# ── Local LLM via Ollama ─────────────────────
# Install: https://ollama.com
# Start:   ollama serve
# Pull:    ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Embedding Model ──────────────────────────
# Default is all-MiniLM-L6-v2 (fast, ~80MB download on first run)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Chunking Tuning ──────────────────────────
CHUNK_MAX_WORDS=400
CHUNK_OVERLAP_SENTENCES=2

# ── Persistence ──────────────────────────────
DATA_DIR=data

# ── Network ──────────────────────────────────
REQUEST_TIMEOUT=60
